  {
    "annotations": {
      "readOnlyHint": true
    },
    "description": "Run one read-only statement. PostgreSQL: inside a READ ONLY transaction (30s timeout) on a connection that is discarded afterwards; writes and multiple statements are rejected, and calls to known side-effect functions (pg_terminate_backend, pg_notify, dblink, advisory locks, file access, large objects, ...) are blocked on a best-effort basis only, so connect with a read-only database role for real protection. Read-only sources (Athena, DynamoDB, OpenSearch, Loki, Prometheus, Grafana) get their own query language; write-like queries are refused before sending, and expensive ones (Athena SELECT without LIMIT or WHERE, DynamoDB full scan, OpenSearch size over 10000) are refused unless force is true. Athena and DynamoDB data reads are billed per request or byte scanned, so they are refused unless the server runs with DB_ALLOW_BILLED=1 (the error says so; nothing was sent). aws connections have no query language; use aws_tree and aws_open.",
    "inputSchema": {
      "type": "object",
      "properties": {
        "connection": {
          "type": "string",
          "description": "PostgreSQL or read-only source connection name (not aws)"
        },
        "sql": {
          "type": "string",
          "description": "a single read-only statement: PostgreSQL or Athena SQL (select, with, show, describe, explain), OpenSearch SQL or DSL, LogQL, PromQL or DynamoDB PartiQL SELECT"
        },
        "max_rows": {
          "type": "integer",
          "description": "maximum rows to return; capped by the server limit"
        },
        "force": {
          "type": "boolean",
          "description": "send a query the source flagged as expensive. Athena bills per byte scanned and DynamoDB scans read the whole table; set only after the user accepts the cost. Ignored for PostgreSQL"
        }
      },
      "required": [
        "connection",
        "sql"
      ],
      "additionalProperties": false
    },
    "name": "query",
    "outputSchema": {
      "type": "object",
      "properties": {
        "columns": {
          "type": [
            "null",
            "array"
          ],
          "items": {
            "type": "string"
          }
        },
        "rows": {
          "type": [
            "null",
            "array"
          ],
          "items": {
            "type": [
              "null",
              "array"
            ],
            "items": {
              "type": "string"
            }
          }
        },
        "text": {
          "type": "string",
          "description": "non-tabular result such as a command tag or a string value"
        },
        "truncated": {
          "type": "boolean",
          "description": "true when rows or values were cut to fit the limits"
        }
      },
      "required": [
        "truncated"
      ],
      "additionalProperties": false
    }
  },
